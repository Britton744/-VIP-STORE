rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow create: if
        request.resource.data.keys().hasAll(['customer','items','total','status','createdAt']) &&
        request.resource.data.customer.name is string &&
        request.resource.data.customer.phone is string &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.total is number &&
        request.resource.data.status == 'جديد';
      allow read, update, delete: if isAdmin();
    }
    match /pageViews/{viewId} {
      allow create: if request.resource.data.page is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}